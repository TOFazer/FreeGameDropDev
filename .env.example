# Copie ce fichier en « .env » puis remplis-le : cp .env.example .env
# Le fichier .env n'est jamais versionné (voir .gitignore).

# ---------- Obligatoire ----------

# Token du bot, onglet « Bot » sur https://discord.com/developers/applications
DISCORD_TOKEN=colle-ton-token-ici


# ---------- Optionnel (valeurs par défaut indiquées) ----------

# Fichier SQLite où sont stockés les salons, rôles et annonces déjà envoyées.
DB_PATH=bot.db

# Rythme de vérification des nouveaux jeux gratuits, en heures.
CHECK_INTERVAL_HOURS=1

# Nombre de jeux récents examinés à chaque vérification.
MAX_GAMES=10

# Verbosité des logs : DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Nom de la catégorie et du salon de choix des rôles créés par /setup-auto.
CATEGORY_NAME=🎮 Jeux gratuits
ROLES_CHANNEL=choisir-ses-roles

# Serveur dont les anciennes copies de commandes sont nettoyées au démarrage.
# Mets 0 pour désactiver ce nettoyage.
TEST_GUILD_ID=1391429196105912452

# API source des jeux gratuits.
GAMERPOWER_API_URL=https://www.gamerpower.com/api/giveaways
GAMERPOWER_TIMEOUT=15
