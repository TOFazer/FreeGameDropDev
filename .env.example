# Copie ce fichier en « .env » puis remplis-le : cp .env.example .env
# Le fichier .env n'est jamais versionné (voir .gitignore).
#
# Ce modèle décrit l'instance de DÉVELOPPEMENT (voir ENVIRONMENTS.md). Pour la
# production, ENVIRONMENT=production, EXPECTED_ENVIRONMENT=production et une base
# distincte : le bot refuse de démarrer si les deux environnements se mélangent.
# Le token ne vient JAMAIS d'ailleurs que de DISCORD_TOKEN ci-dessous : ENVIRONMENT
# ne sert qu'à vérifier que jeton, application Discord et base vont bien ensemble.

# ---------- Environnement ----------

# development ou production.
ENVIRONMENT=development

# Environnement attendu sur cette machine. S'il ne correspond pas à ENVIRONMENT,
# le démarrage est refusé (protection contre un `.env` de prod copié en dev).
EXPECTED_ENVIRONMENT=development

# Identifiant de l'application Discord de CET environnement (onglet « General
# Information »). L'identifiant encodé dans le token doit être le même, sinon
# « Discord application mismatch » et arrêt immédiat.
DISCORD_APPLICATION_ID=

# Suspend les annonces automatiques (les commandes d'administration restent
# utilisables). Pratique pour tester sans inquiéter les membres.
MAINTENANCE_MODE=false


# ---------- Obligatoire ----------

# Token du bot, onglet « Bot » sur https://discord.com/developers/applications
# En dev : le token de l'application « FreeGameDrop Dev », jamais celui de la prod.
DISCORD_TOKEN=colle-ton-token-ici


# ---------- Optionnel (valeurs par défaut indiquées) ----------

# Fichier SQLite où sont stockés les salons, rôles et annonces déjà envoyées.
# Le dossier est créé automatiquement ; le fichier est ignoré par git.
# En production : bot.db (ou /app/data/bot.db dans Docker).
DB_PATH=data/freegamedrop-dev.db

# Rythme de vérification des nouveaux jeux gratuits, en heures.
CHECK_INTERVAL_HOURS=1

# Nombre de jeux récents examinés à chaque vérification.
MAX_GAMES=10

# Verbosité des logs : DEBUG, INFO, WARNING, ERROR.
# Défaut : DEBUG en development, INFO en production (journaux plus calmes).
LOG_LEVEL=DEBUG

# Fichier de journal supplémentaire (rotation automatique : 5 Mo × 3 fichiers).
# Vide = sortie standard uniquement. Les tokens, mots de passe et URL de webhook y
# sont masqués de la même façon que sur la sortie standard.
LOG_FILE=

# Remplace les identifiants Discord (membres, serveurs) par une empreinte stable dans
# les logs. À activer si le journal doit sortir de ton infrastructure.
LOG_PSEUDONYMIZE_IDS=false

# Longueur maximale d'un champ dans les lignes de journal `event=…` (tronqué au-delà).
LOG_MAX_FIELD_CHARS=160

# Liens affichés par /info. VOTE_URL peut rester vide si le bot n'est pas encore listé.
PROJECT_URL=https://github.com/TOFazer/freegamedrop
SUPPORT_URL=https://github.com/TOFazer/freegamedrop/issues
VOTE_URL=

# Nom de la catégorie et du salon de choix des rôles créés par /setup-auto.
CATEGORY_NAME=🎮 Jeux gratuits
ROLES_CHANNEL=choisir-ses-roles

# Serveur dont les anciennes copies de commandes sont nettoyées au démarrage.
# Mets 0 pour désactiver ce nettoyage.
TEST_GUILD_ID=1391429196105912452

# API source des jeux gratuits.
GAMERPOWER_API_URL=https://www.gamerpower.com/api/giveaways
GAMERPOWER_TIMEOUT=15

# Source Epic Games Store (jeux offerts chaque semaine).
EPIC_API_URL=https://store-site-backend-static.ak.epicgames.com/freeGamesPromotions
EPIC_TIMEOUT=15
EPIC_STORE_URL=https://store.epicgames.com
EPIC_LOCALE=fr-FR
EPIC_COUNTRY=FR

# Sources activées pour /free, les alertes et la veille automatique (liste séparée par des virgules).
OFFER_SOURCES=gamerpower,epic
OFFER_SOURCE_TIMEOUT=20

# Durée de réutilisation des offres déjà récupérées par /free, en secondes. Plusieurs
# membres peuvent consulter le catalogue sans marteler les sources (un seul appel partagé).
OFFER_CACHE_SECONDS=60

# Fuseau horaire utilisé par défaut pour les filtres de date de /free.
DEFAULT_TIMEZONE=Europe/Paris

# Délai minimal entre deux alertes DM identiques envoyées à un même membre, en heures.
ALERT_CADENCE_HOURS=1
# Fenêtre considérée comme « se termine bientôt » pour les alertes et /free, en heures.
LAST_DAY_HOURS=24

# Seuil (en euros, valeur explicitement libellée en euros par la source) au-dessus duquel
# un jeu complet temporaire est mis en avant « 🔥 Offre exceptionnelle ». 0 = désactivé.
MEGA_DEAL_MIN_WORTH_EUR=19.99

# ---------- Limites de débit ----------
# Ces limites protègent les sources et l'API Discord ; elles sont volontairement larges,
# un membre normal ne les remarque jamais. Détail par commande : utils/rate_limits.py.

# Plafond, par membre, toutes commandes de lecture confondues.
RATE_LIMIT_USER_PER_MINUTE=20
# Appels de /free par membre et par minute.
RATE_LIMIT_FREE_PER_MINUTE=4
# Actions de configuration par serveur et par minute (les admins partagent ce quota).
RATE_LIMIT_ADMIN_PER_MINUTE=6
# Tests et réinitialisations par serveur, sur 10 minutes.
RATE_LIMIT_ADMIN_HEAVY_PER_10_MINUTES=3
# Espacement minimal entre deux messages d'un même salon ou à un même membre, en secondes.
# Respecte les limites de cadence imposées par Discord.
DISCORD_SEND_INTERVAL_SECONDS=0.4

# ---------- Surveillance (monitoring) ----------
# Mettre false pour désactiver la boucle de surveillance et ses alertes.
MONITOR_ENABLED=true
# Fréquence des contrôles, en minutes.
MONITOR_INTERVAL_MINUTES=5

# Salon qui reçoit les alertes de surveillance. Vide = message privé au propriétaire.
MONITOR_ALERT_CHANNEL_ID=
# Destinataire de secours si aucun salon n'est configuré (vide = propriétaire du bot).
MONITOR_OWNER_ID=

# Une source sans succès depuis ce délai est déclarée indisponible (alerte).
SOURCE_DOWN_AFTER_MINUTES=10
# Deux alertes identiques ne sont pas répétées avant ce délai, en minutes.
MONITOR_ALERT_COOLDOWN_MINUTES=30
# Pic d'erreurs : nombre d'erreurs sur la fenêtre glissante ci-dessous.
MONITOR_ERROR_WINDOW_MINUTES=15
MONITOR_ERROR_ALERT_THRESHOLD=10
# Marge accordée à une tâche de fond avant de la signaler comme arrêtée, en minutes.
MONITOR_TASK_GRACE_MINUTES=10
# Latence Discord (ms) au-delà de laquelle la connexion est signalée comme dégradée.
MONITOR_LATENCY_WARN_MS=1000

# ---------- Tableau de bord web (optionnel) ----------

# Mettre à true pour démarrer le petit serveur web à côté du bot.
# En développement, le tableau de bord s'affiche en « 🧪 FreeGameDrop DEV » : impossible
# de le confondre avec celui de la production.
DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_SECRET_KEY=change-me-en-dev
DASHBOARD_BASE_URL=http://localhost:8080

# Marque les cookies de session « Secure » (exigés en HTTPS par les navigateurs).
# Par défaut activé automatiquement si DASHBOARD_BASE_URL commence par https://.
# Ne mets jamais DASHBOARD_COOKIE_SECURE=false en production exposée publiquement.
DASHBOARD_COOKIE_SECURE=

# Identifiants OAuth2 de l'application Discord de CET environnement (onglet
# « OAuth2 »), nécessaires uniquement si DASHBOARD_ENABLED=true et que tu veux la
# connexion Discord. Scopes demandés : identify + guilds (pour lister les serveurs
# gérables du membre). Le jeton OAuth du membre n'est jamais stocké en base.
#
# DEV et PROD ont deux applications Discord distinctes, donc deux Client Secret
# distincts et deux redirections distinctes :
#   DEV  : http://localhost:8080/auth/callback
#   PROD : https://ton-domaine/auth/callback
# DISCORD_CLIENT_ID doit être l'application du token ci-dessus, sinon le bot refuse
# de démarrer (« Discord application mismatch »).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback
